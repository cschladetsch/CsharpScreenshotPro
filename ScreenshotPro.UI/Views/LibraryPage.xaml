<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenshotPro.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ScreenshotPro.UI.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToSelectionBrushConverter x:Key="BoolToSelectionBrushConverter"/>
    </Page.Resources>

    <Grid Background="#FF1F1F23" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Spacing="16">
            <Button Content="New Capture"
                    Padding="18,10"
                    Background="#FF2B6CB0"
                    Foreground="White"
                    CornerRadius="8"
                    Click="NewCaptureButton_Click"
                    PointerEntered="NewCaptureButton_PointerEntered"/>
            <Button Content="Open Folder"
                    Padding="18,10"
                    Background="#FF4A5568"
                    Foreground="White"
                    CornerRadius="8"
                    Click="OpenFolderButton_Click"/>
            <ComboBox Width="160" SelectedIndex="0">
                <ComboBoxItem>All Screenshots</ComboBoxItem>
                <ComboBoxItem>Last 7 Days</ComboBoxItem>
                <ComboBoxItem>Templates</ComboBoxItem>
            </ComboBox>
            <AutoSuggestBox Width="280"
                            PlaceholderText="Search all screenshots"/>
            <Button Content="Delete"
                    Padding="18,10"
                    Background="#FFE53E3E"
                    Foreground="White"
                    CornerRadius="8"
                    Click="DeleteButton_Click"
                    IsEnabled="{x:Bind HasSelectedItems, Mode=OneWay}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Collections" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <ListView SelectionMode="Single">
                    <ListViewItem Content="All Screenshots" IsSelected="True"/>
                    <ListViewItem Content="Organize by Date"/>
                    <ListViewItem Content="Templates"/>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Text="Recent Captures" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <GridView Name="ScreenshotsGridView"
                          SelectionMode="None"
                          ItemsSource="{x:Bind Screenshots, Mode=OneWay}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:ScreenshotItem">
                            <StackPanel Spacing="6" Width="160">
                                <Border Background="#FF2F2F35" CornerRadius="12" Height="120">
                                    <Grid>
                                        <Image Source="{x:Bind ThumbnailPath}"
                                               Stretch="UniformToFill"/>
                                        <!-- Selection circle in top-right corner -->
                                        <Border Background="#80000000"
                                                CornerRadius="12"
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="6">
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     Stroke="White"
                                                     StrokeThickness="2"
                                                     Fill="{x:Bind IsSelected, Converter={StaticResource BoolToSelectionBrushConverter}, Mode=OneWay}"
                                                     Tapped="SelectionCircle_Tapped"
                                                     Tag="{x:Bind}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{x:Bind FileName}"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind FormattedDate}"
                                           Foreground="#FFB0B0B5"
                                           FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
