<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenshotPro.UI.Views.RegionSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Name="MainGrid" Background="Transparent">
        <!-- Desktop screenshot background -->
        <Image Name="DesktopImage" Stretch="UniformToFill"/>

        <!-- Dimming overlay -->
        <Grid Name="OverlayGrid" Background="#40000000">
            <!-- Selection canvas -->
            <Canvas Name="SelectionCanvas">
                <Rectangle Name="SelectionRectangle"
                           Stroke="#FF0078D4"
                           StrokeThickness="2"
                           Fill="Transparent"
                           Visibility="Collapsed"/>
            </Canvas>

        </Grid>
    </Grid>
</Window>