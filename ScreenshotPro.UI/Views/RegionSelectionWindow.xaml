<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenshotPro.UI.Views.RegionSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Name="MainGrid" Background="Transparent">
        <!-- Desktop screenshot background -->
        <Image Name="DesktopImage" Stretch="Fill"/>

        <!-- Overlay container -->
        <Grid Name="OverlayGrid">
            <!-- Canvas for dimming rectangles around selection -->
            <Canvas Name="DimmingCanvas">
                <!-- Top dimming rectangle -->
                <Rectangle Name="TopDimmingRect" Fill="#40000000"/>
                <!-- Bottom dimming rectangle -->
                <Rectangle Name="BottomDimmingRect" Fill="#40000000"/>
                <!-- Left dimming rectangle -->
                <Rectangle Name="LeftDimmingRect" Fill="#40000000"/>
                <!-- Right dimming rectangle -->
                <Rectangle Name="RightDimmingRect" Fill="#40000000"/>
            </Canvas>

            <!-- Selection border -->
            <Canvas Name="SelectionCanvas">
                <Rectangle Name="SelectionRectangle"
                           Stroke="#FF0078D4"
                           StrokeThickness="2"
                           Fill="Transparent"
                           Visibility="Collapsed"/>
            </Canvas>
        </Grid>
    </Grid>
</Window>