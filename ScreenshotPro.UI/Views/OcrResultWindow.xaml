<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenshotPro.UI.Views.OcrResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FF1F1F23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   Text="Extracted Text"
                   FontWeight="SemiBold"
                   FontSize="16"
                   Foreground="White"
                   Margin="20,20,20,16"/>

        <!-- Text Content -->
        <Border Grid.Row="1"
                Margin="20,0,20,16"
                Background="#FF2D2D30"
                CornerRadius="4"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <RichTextBlock x:Name="TextContent"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               FontFamily="Consolas"
                               Foreground="White"
                               FontSize="14"
                               LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="20,0,20,20">
            <TextBlock Text="Text has been copied to clipboard"
                       FontStyle="Italic"
                       Foreground="#FFB4B4B4"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button Content="Copy Again"
                    Padding="16,8"
                    Background="#FF2B6CB0"
                    Foreground="White"
                    CornerRadius="4"
                    Click="CopyAgainButton_Click"/>
            <Button Content="Close"
                    Padding="16,8"
                    Background="#FF4A5568"
                    Foreground="White"
                    CornerRadius="4"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>