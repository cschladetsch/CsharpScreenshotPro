<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenshotPro.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FF1F1F23" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Spacing="16">
            <Button Content="New Capture"
                    Padding="18,10"
                    Background="#FF2B6CB0"
                    Foreground="White"
                    CornerRadius="8"
                    Click="NewCaptureButton_Click"/>
            <ComboBox Width="160" SelectedIndex="0">
                <ComboBoxItem>All Screenshots</ComboBoxItem>
                <ComboBoxItem>Last 7 Days</ComboBoxItem>
                <ComboBoxItem>Templates</ComboBoxItem>
            </ComboBox>
            <AutoSuggestBox Width="280"
                            PlaceholderText="Search all screenshots"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Collections" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <ListView SelectionMode="Single">
                    <ListViewItem Content="All Screenshots" IsSelected="True"/>
                    <ListViewItem Content="Organize by Date"/>
                    <ListViewItem Content="Templates"/>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Text="Recent Captures" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <GridView SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridViewItem>
                        <StackPanel Spacing="6">
                            <Border Background="#FF2F2F35" CornerRadius="12" Height="120"/>
                            <TextBlock Text="Screenshot_2025-09-16_14-20-00" Foreground="White"/>
                            <TextBlock Text="Sep 16, 2025 2:20 PM" Foreground="#FFB0B0B5" FontSize="12"/>
                        </StackPanel>
                    </GridViewItem>
                    <GridViewItem>
                        <StackPanel Spacing="6">
                            <Border Background="#FF2F2F35" CornerRadius="12" Height="120"/>
                            <TextBlock Text="Screenshot_2025-09-16_14-11-32" Foreground="White"/>
                            <TextBlock Text="Sep 16, 2025 2:11 PM" Foreground="#FFB0B0B5" FontSize="12"/>
                        </StackPanel>
                    </GridViewItem>
                    <GridViewItem>
                        <StackPanel Spacing="6">
                            <Border Background="#FF2F2F35" CornerRadius="12" Height="120"/>
                            <TextBlock Text="Screenshot_2025-09-16_13-58-04" Foreground="White"/>
                            <TextBlock Text="Sep 16, 2025 1:58 PM" Foreground="#FFB0B0B5" FontSize="12"/>
                        </StackPanel>
                    </GridViewItem>
                    <GridViewItem>
                        <StackPanel Spacing="6">
                            <Border Background="#FF2F2F35" CornerRadius="12" Height="120"/>
                            <TextBlock Text="Screenshot_2025-09-16_13-40-42" Foreground="White"/>
                            <TextBlock Text="Sep 16, 2025 1:40 PM" Foreground="#FFB0B0B5" FontSize="12"/>
                        </StackPanel>
                    </GridViewItem>
                    <GridViewItem>
                        <StackPanel Spacing="6">
                            <Border Background="#FF2F2F35" CornerRadius="12" Height="120"/>
                            <TextBlock Text="Screenshot_2025-09-16_13-28-15" Foreground="White"/>
                            <TextBlock Text="Sep 16, 2025 1:28 PM" Foreground="#FFB0B0B5" FontSize="12"/>
                        </StackPanel>
                    </GridViewItem>
                    <GridViewItem>
                        <StackPanel Spacing="6">
                            <Border Background="#FF2F2F35" CornerRadius="12" Height="120"/>
                            <TextBlock Text="Screenshot_2025-09-16_13-12-54" Foreground="White"/>
                            <TextBlock Text="Sep 16, 2025 1:12 PM" Foreground="#FFB0B0B5" FontSize="12"/>
                        </StackPanel>
                    </GridViewItem>
                </GridView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
