<?xml version="1.0" encoding="utf-8"?>
<local:TrackedWindow
    x:Class="ScreenshotPro.UI.Views.SnippetViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenshotPro.UI.Views">

    <Grid Background="#FF1F1F23">
        <!-- Main content area -->
        <ScrollViewer Name="ImageScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <Image Name="SnippetImage"
                   Stretch="None"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- Top toolbar -->
        <Grid VerticalAlignment="Top"
              Background="#CC000000"
              Height="48">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Margin="16,0">
                <Grid>
                    <TextBlock Name="FileNameText"
                               Foreground="White"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Tapped="FileNameText_Tapped"/>
                    <TextBox Name="FileNameEditBox"
                             Foreground="White"
                             FontSize="16"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             KeyDown="FileNameEditBox_KeyDown"
                             LostFocus="FileNameEditBox_LostFocus"/>
                </Grid>
                <TextBlock Name="FileSizeText"
                           Foreground="#FFB0B0B5"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="16,0">
                <Button Content="Extract Text"
                        Click="ExtractTextButton_Click"
                        Padding="12,6"
                        Background="#FF6B46C1"
                        Foreground="White"
                        CornerRadius="4"/>
                <Button Content="Copy"
                        Click="CopyButton_Click"
                        Padding="12,6"
                        Background="#FF4A5568"
                        Foreground="White"
                        CornerRadius="4"/>
                <Button Content="Save As..."
                        Click="SaveAsButton_Click"
                        Padding="12,6"
                        Background="#FF4A5568"
                        Foreground="White"
                        CornerRadius="4"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:TrackedWindow>