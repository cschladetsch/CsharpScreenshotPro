<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenshotPro.UI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ScreenshotPro.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="RootNav"
                    IsBackEnabled="False"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    IsPaneOpen="False"
                    ItemInvoked="RootNav_ItemInvoked"
                    Loaded="RootNav_Loaded">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Library" Icon="Library" Tag="library"/>
            <NavigationViewItem Content="Editor" Icon="Edit" Tag="editor"/>
            <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings"/>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
