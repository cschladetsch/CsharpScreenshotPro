<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenshotPro.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Text="Preferences" FontSize="22" FontWeight="SemiBold"/>
            <ListView SelectionMode="Single" Width="200">
                <ListViewItem Content="Capture"/>
                <ListViewItem Content="Files &amp; Naming" IsSelected="True"/>
                <ListViewItem Content="Hotkeys"/>
                <ListViewItem Content="Appearance"/>
            </ListView>
        </StackPanel>

        <Border Grid.Column="1"
                Margin="32,0,0,0"
                Background="White"
                CornerRadius="18"
                Padding="32">
            <StackPanel Spacing="20">
                <TextBlock Text="Capture Settings" FontSize="22" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Default Capture Mode" Width="200" VerticalAlignment="Center"/>
                    <ComboBox Width="200" SelectedIndex="0">
                        <ComboBoxItem>Selected Region</ComboBoxItem>
                        <ComboBoxItem>Active Window</ComboBoxItem>
                        <ComboBoxItem>Full Screen</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Include Cursor" Width="200" VerticalAlignment="Center"/>
                    <ToggleSwitch IsOn="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Capture Delay (seconds)" Width="200" VerticalAlignment="Center"/>
                    <muxc:NumberBox Width="120"
                                     Value="3"
                                     Minimum="0"
                                     Maximum="30"
                                     SpinButtonPlacementMode="Compact"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Auto Copy to Clipboard" Width="200" VerticalAlignment="Center"/>
                    <ToggleSwitch IsOn="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Play Capture Sound" Width="200" VerticalAlignment="Center"/>
                    <ToggleSwitch IsOn="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
